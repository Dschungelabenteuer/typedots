{
  "name": "typedots",
  "version": "0.2.0",
  "description": "A simple way to get and set object properties using paths (aka dot notation) with TypeScript support",
  "keywords": [
    "Access",
    "Autocompletion",
    "Code completion",
    "Data retrieval",
    "Data structure",
    "Dot notation",
    "Navigation",
    "Nested objects",
    "Object hierarchy",
    "Object path",
    "Path",
    "Property access",
    "Reflection",
    "Strongly typed objects",
    "Suggestions",
    "Traversal",
    "Type safety",
    "TypeScript",
    "Typedots"
  ],
  "homepage": "https://github.com/Dschungelabenteuer/typedots/tree/main/#readme",
  "bugs": {
    "url": "https://github.com/Dschungelabenteuer/typedots/issues"
  },
  "license": "MIT",
  "author": "Charles Gruenais",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dschungelabenteuer/typedots"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "coverage": "vitest run --coverage",
    "format": "oxfmt",
    "knip": "knip",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "knip": "^6.35.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.3.4"
}
