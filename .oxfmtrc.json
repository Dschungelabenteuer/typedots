{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "arrowParens": "always",
  "quoteProps": "consistent",
  "objectWrap": "collapse",
  "trailingComma": "es5",
  "jsxSingleQuote": true,
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": true,
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": { "sortScripts": true }
}
